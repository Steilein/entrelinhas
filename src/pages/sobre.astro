---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Starburst from '../components/Starburst.astro';
import Wordmark from '../components/Wordmark.astro';
import PartnerCard from '../components/PartnerCard.astro';
import Arrow from '../components/Arrow.astro';
import Marquee from '../components/Marquee.astro';
import { getPontos } from '../lib/content';
import { site } from '../data/site';
import { url } from '../lib/url';

const parceiros = (await getCollection('parceiros')).sort((a, b) => a.data.ordem - b.data.ordem);
const pontos = await getPontos();
const expositores = pontos.filter((p) => p.data.tipo === 'expositor').length;

const numeros = [
  { n: '6', label: 'meses de projeto', cor: 'magenta' },
  { n: '1', label: 'livreto novo por mês', cor: 'lima' },
  { n: 'R$ 0', label: 'é o preço de cada edição', cor: 'ciano' },
  { n: String(expositores), label: 'expositores pela cidade', cor: 'preto' },
];

const pecas = [
  {
    nome: 'Livreto',
    img: '/fotos/9439-p.webp',
    alt: 'Livreto da edição 01 com a cinta “O feminino não vem de fábrica”, segurado com as duas mãos.',
    texto: '36 páginas em formato de bolso (10,5 × 14 cm): cinco capítulos, obras de arte, um glossário e um espaço para você responder.',
  },
  {
    nome: 'Cinta',
    img: '/pecas/cinta.webp',
    alt: 'Cinta magenta com o título “O feminino não vem de fábrica” e a assinatura do entrelinhas.',
    texto: 'Envolve o livreto e identifica a edição. A cada mês, uma cinta nova para a coleção.',
  },
  {
    nome: 'Marcador',
    img: '/pecas/marcador.webp',
    alt: 'Marcador branco com a frase “Leia entrelinhas” em magenta e estrelas.',
    texto: '“Leia entrelinhas”: vai junto com o livreto e continua circulando depois dele.',
  },
  {
    nome: 'Fanzine',
    img: '/pecas/fanzine.webp',
    alt: 'Os oito painéis do fanzine, em lima, ciano e magenta, com as frases do projeto.',
    verso: '/pecas/fanzine-poster.webp',
    versoAlt: 'O verso do fanzine: a obra do rosto vermelho e ciano, a mesma de um dos lambe-lambes.',
    texto: 'Uma folha dobrada em oito painéis que apresenta o projeto. No verso, uma das obras dos lambe-lambes: aberta, vira um pôster para você levar a arte da rua para casa.',
  },
];

const faq = [
  {
    q: 'O livreto é mesmo gratuito?',
    a: 'Sim. A proposta do entrelinhas é que o conhecimento circule: os livretos ficam nos expositores para quem quiser levar, sem custo.',
  },
  {
    q: 'Onde eu encontro um livreto?',
    a: `No <a href="${url('/mapa')}">mapa</a> estão todos os expositores, com endereço e as edições disponíveis em cada um. O botão “perto de mim” mostra o mais próximo.`,
  },
  {
    q: 'Posso levar mais de um?',
    a: 'Leve o seu e, se quiser, um para alguém que vai gostar de ler. Só lembre que outras pessoas também estão procurando.',
  },
  {
    q: 'Perdi uma edição. E agora?',
    a: `Todas as edições lançadas ficam disponíveis na <a href="${url('/edicoes')}">versão digital</a>, para ler online.`,
  },
  {
    q: 'Posso levar o entrelinhas para minha escola ou coletivo?',
    a: `Pode e deve! Escreva para <a href="mailto:${site.email}">${site.email}</a> e a gente conversa.`,
  },
  {
    q: 'Posso ficar com a arte dos lambe-lambes?',
    a: `Pode! O fanzine que acompanha o livreto traz, num dos versos, uma das obras da campanha. Aberto, ele vira um pôster. Veja todas as obras na <a href="${url('/galeria')}">galeria</a>.`,
  },
  {
    q: 'Quem faz o entrelinhas?',
    a: 'O entrelinhas é um projeto editorial independente que articula comunicação, arte e mobilização social para provocar reflexões sobre o feminino. Sua construção acontece em parceria com coletivos e movimentos de mulheres, fortalecendo espaços de diálogo e transformação.',
  },
];
---

<Base
  title="Sobre"
  description="O entrelinhas estimula o pensamento crítico sobre as construções sociais do feminino com livretos gratuitos distribuídos em Curitiba."
>
  <section class="sobre-hero bg-magenta grain">
    <div class="container sobre-hero-inner">
      <p class="eyebrow">sobre o projeto</p>
      <h1>Questionar o que parece <span class="box box--ciano">inquestionável.</span></h1>
    </div>
    <Starburst class="sobre-hero-star" seed={14} points={16} fill="var(--lima)" spin />
    <Starburst class="sobre-hero-star2" seed={15} points={12} fill="var(--preto)" />
  </section>

  <section class="section container intro">
    <p class="intro-big">
      <span class="box box--lima">O feminino social é nosso campo de investigação.</span>
    </p>
    <div class="intro-cols">
      <p>
        Nosso propósito é produzir e compartilhar conhecimento sobre suas construções, representações e transformações, trazendo à discussão questões frequentemente invisibilizadas ou naturalizadas.
      </p>
      <p>
        O entrelinhas é uma iniciativa editorial que distribui livretos gratuitos com linguagem direta: traz teóricas, artigos e assuntos densos de forma instigante, para provocar reflexões, confrontar perspectivas e abrir espaço para novos sentidos.
      </p>
    </div>
  </section>

  <section class="nome bg-preto">
    <div class="container nome-inner">
      <div class="nome-mark">
        <Wordmark size="clamp(3.2rem, 9vw, 8rem)" star="var(--lima)" />
      </div>
      <div class="nome-text">
        <p class="eyebrow">por que esse nome?</p>
        <h2>Porque nem tudo está dito.</h2>
        <p>
          Muito do que define o feminino na nossa sociedade não está escrito em lugar nenhum: aparece de forma sutil no imaginário e na percepção de todo mundo. O entrelinhas existe para trazer à tona aquilo que nem sempre é enxergado ou falado.
        </p>
        <p>
          Nem tudo está visível. E nem tudo que aprendemos precisa permanecer como está.
        </p>
      </div>
    </div>
  </section>

  <section class="section container como" aria-labelledby="como-titulo">
    <div class="como-head">
      <p class="eyebrow">como funciona</p>
      <h2 id="como-titulo">Ideias ganham forma.<br />Perspectivas ganham mundo.</h2>
    </div>
    <ul class="numeros" role="list">
      {numeros.map((item) => (
        <li class:list={['numero', `bg-${item.cor}`, 'reveal']}>
          <span class="numero-n">{item.n}</span>
          <span class="numero-l">{item.label}</span>
        </li>
      ))}
    </ul>
    <div class="como-cols">
      <div>
        <h3>Livretos pela cidade</h3>
        <p>Durante seis meses, uma edição nova sai a cada mês e chega a expositores em bibliotecas, universidades, teatros e centros culturais de {site.cidade}. É só chegar e levar.</p>
      </div>
      <div>
        <h3>Campanha nas ruas</h3>
        <p>Lambe-lambes e mídia exterior levam as perguntas do entrelinhas para os muros, com obras que dialogam com o feminino. As mesmas obras estampam o verso do fanzine. <a href={url('/galeria')}>Veja a galeria.</a></p>
      </div>
      <div>
        <h3>Edição digital</h3>
        <p>Cada edição também pode ser lida online, página por página, para quem não encontrou o impresso ou quer reler. <a href={url('/edicoes')}>Ler as edições.</a></p>
      </div>
    </div>
  </section>

  <Marquee items={['para quem está construindo o próprio olhar', 'jovens de 18 a 30 anos', 'curiosas, curiosos, curioses', 'quem quer abrir horizontes']} tone="lima" speed={40} />

  <section class="section container para-quem">
    <p class="eyebrow">para quem</p>
    <p class="para-quem-text">
      Para pessoas jovens, entre 18 e 30 anos, que estão construindo a si mesmas e a própria percepção de mundo, e que topam abrir horizontes sobre um assunto que atravessa a vida de todo mundo.
    </p>
  </section>

  <section class="section container pecas" aria-labelledby="pecas-titulo">
    <div class="pecas-head">
      <p class="eyebrow">as peças</p>
      <h2 id="pecas-titulo">Um kit para ler, guardar <span class="box box--magenta">e passar adiante.</span></h2>
    </div>
    <ul class="pecas-grid" role="list">
      {pecas.map((p) => (
        <li class="peca">
          <div class:list={['peca-img', { 'peca-img--verso': p.verso }]}>
            <img src={url(p.img)} alt={p.alt} loading="lazy" decoding="async" />
            {p.verso && <img class="peca-verso" src={url(p.verso)} alt={p.versoAlt} loading="lazy" decoding="async" />}
          </div>
          <h3>{p.nome}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ul>
    <p class="pecas-mais"><a class="btn btn--ghost" href={url('/galeria#ensaio-titulo')}>ver o ensaio fotográfico <Arrow /></a></p>
  </section>

  <section class="section parceiros-sec bg-cinza" id="parceiros" aria-labelledby="parc-titulo">
    <div class="container">
      <div class="parc-head">
        <p class="eyebrow">parceiros</p>
        <h2 id="parc-titulo"><span class="box box--lima">Nenhum conhecimento se constrói sozinho.</span></h2>
        <p>O entrelinhas se fortalece no diálogo com coletivos, movimentos e iniciativas que compartilham saberes, experiências e possibilidades de construção. São eles que tornam viáveis a produção e o caminho de cada livreto até você.</p>
      </div>
      <div class="parc-grid">
        {parceiros.map((p) => <PartnerCard parceiro={p} />)}
      </div>
    </div>
  </section>

  <section class="section container faq" aria-labelledby="faq-titulo">
    <div class="faq-head">
      <p class="eyebrow">dúvidas</p>
      <h2 id="faq-titulo">Perguntas frequentes</h2>
    </div>
    <div class="faq-list">
      {faq.map((item, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p set:html={item.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="cta-final bg-lima grain">
    <div class="container cta-inner">
      <h2>Tem um livreto esperando por você.</h2>
      <a class="btn btn--magenta" href={url('/mapa')}>encontrar minha edição <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  .pecas-head { display: grid; gap: 14px; margin-bottom: clamp(28px, 4vw, 48px); }
  .pecas-head h2 { font-size: var(--step-4); line-height: 1.05; max-width: 18ch; }
  .pecas-head h2 .box { line-height: 1.2; }
  .pecas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: clamp(20px, 3vw, 36px); }
  .peca { display: grid; gap: 10px; align-content: start; }
  .peca-img { aspect-ratio: 4 / 3; background: var(--cinza, #f0f0ec); display: grid; place-items: center; padding: 14px; border-radius: 4px; overflow: hidden; }
  .peca-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .peca:first-child .peca-img { padding: 0; }
  .peca:first-child .peca-img img { width: 100%; height: 100%; max-height: none; object-fit: cover; }
  /* fanzine: frente e, por cima, o verso que vira pôster */
  .peca-img--verso { position: relative; place-items: center start; padding-right: 30%; }
  .peca-img .peca-verso { position: absolute; right: 7%; bottom: 9%; width: 30%; max-height: none; rotate: 6deg; box-shadow: -5px 6px 0 rgb(0 0 0 / 0.85); }
  .peca h3 { font-size: var(--step-2); }
  .peca p { font-family: var(--font-editorial); line-height: 1.45; }
  .pecas-mais { margin-top: clamp(24px, 3vw, 36px); }
  .sobre-hero { position: relative; overflow: hidden; border-bottom: 2px solid var(--preto); }
  .sobre-hero-inner { position: relative; z-index: 1; padding-block: clamp(64px, 11vw, 160px); }
  .sobre-hero h1 { font-size: clamp(2.5rem, 1rem + 6.4vw, 7.2rem); max-width: 16ch; letter-spacing: -0.045em; }
  .sobre-hero h1 .box { line-height: 1.12; }
  .sobre-hero .eyebrow { margin-bottom: 16px; }
  .sobre-hero :global(.sobre-hero-star) { position: absolute; width: clamp(220px, 30vw, 440px); right: 4%; top: 12%; }
  .sobre-hero :global(.sobre-hero-star2) { position: absolute; width: clamp(90px, 10vw, 150px); right: 30%; bottom: -40px; }

  .intro { display: grid; gap: clamp(28px, 4vw, 48px); }
  .intro-big { font-family: var(--font-text); font-weight: 300; font-size: var(--step-4); line-height: 1.2; max-width: 20ch; }
  .intro-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 4vw, 64px); font-family: var(--font-editorial); font-size: var(--step-1); line-height: 1.45; }

  .nome-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; padding-block: clamp(64px, 10vw, 140px); }
  .nome-mark { color: var(--branco); }
  .nome-text { display: grid; gap: 16px; font-size: var(--step-1); line-height: 1.45; font-weight: 300; }
  .nome-text h2 { font-size: var(--step-4); color: var(--lima); }
  .nome-text p:not(.eyebrow) { font-family: var(--font-editorial); }
  .nome-text .eyebrow { color: var(--lima); }

  .como-head { margin-bottom: clamp(32px, 5vw, 56px); }
  .como-head .eyebrow { margin-bottom: 12px; }
  .numeros { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .numero { display: grid; gap: 6px; align-content: end; min-height: 200px; padding: 22px; border-radius: var(--radius); border: 2px solid var(--preto); }
  .numero-n { font-family: var(--font-display); font-weight: 900; font-size: var(--step-5); line-height: 0.85; letter-spacing: -0.05em; }
  .numero-l { font-family: var(--font-display); font-weight: 600; line-height: 1.15; }
  .como-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 48px); margin-top: clamp(40px, 6vw, 72px); }
  .como-cols h3 { margin-bottom: 10px; padding-top: 14px; border-top: 2px solid var(--preto); }
  .como-cols p { font-family: var(--font-editorial); }
  .como-cols a { font-weight: 600; }

  .para-quem .eyebrow { margin-bottom: 16px; }
  .para-quem-text { font-family: var(--font-display); font-weight: 800; font-size: var(--step-3); line-height: 1.08; letter-spacing: -0.03em; max-width: 26ch; }

  .bg-cinza { background: var(--cinza); }
  .parc-head { display: grid; gap: 18px; max-width: 60ch; margin-bottom: clamp(32px, 5vw, 56px); }
  .intro-big, .parc-head h2 { --box-topo: 0em; --box-base: 0em; }
  .parc-head h2 { font-family: var(--font-text); font-weight: 300; font-size: var(--step-4); line-height: 1.18; letter-spacing: -0.01em; }
  .parc-head p:not(.eyebrow) { font-family: var(--font-editorial); font-size: var(--step-1); line-height: 1.45; }
  .parc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .parc-grid :global(.partner) { grid-template-columns: 1fr; align-items: start; }

  .faq { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(28px, 5vw, 80px); }
  .faq-head .eyebrow { margin-bottom: 12px; }
  .faq-list { display: grid; gap: 10px; }
  details { border: 2px solid var(--preto); border-radius: var(--radius); background: var(--branco); overflow: hidden; }
  details[open] { background: var(--lima); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.2;
  }
  summary::-webkit-details-marker { display: none; }
  .faq-icon { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--preto); }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2.5px; background: var(--branco); translate: -50% -50%; transition: rotate 0.3s var(--ease-out); }
  .faq-icon::after { rotate: 90deg; }
  details[open] .faq-icon::after { rotate: 0deg; }
  details p { padding: 0 22px 20px; font-family: var(--font-editorial); font-size: var(--step-1); line-height: 1.45; max-width: 58ch; }
  details :global(a) { font-weight: 600; }

  .cta-final { border-top: 2px solid var(--preto); }
  .cta-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; padding-block: clamp(56px, 8vw, 110px); }
  .cta-inner h2 { font-size: var(--step-4); max-width: 16ch; }

  @media (max-width: 900px) {
    .intro-cols, .nome-inner, .como-cols, .faq { grid-template-columns: 1fr; }
    .numeros { grid-template-columns: repeat(2, 1fr); }
    .numero { min-height: 150px; }
    .parc-grid { grid-template-columns: 1fr; }
    .parc-grid :global(.partner) { grid-template-columns: auto 1fr; align-items: center; }
  }
</style>
