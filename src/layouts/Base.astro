---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/zilla-slab/latin-300.css';
import '@fontsource/zilla-slab/latin-300-italic.css';
import '@fontsource/zilla-slab/latin-400.css';
import '@fontsource/zilla-slab/latin-600.css';
import '../styles/global.css';
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** caminho da imagem de compartilhamento (padrão: imagem geral do site) */
  og?: string;
  /** esconde o rodapé (usado na página do mapa em tela cheia, se necessário) */
  footer?: boolean;
  bodyClass?: string;
}

const { title, description = site.descricao, og = url('/og/site.png'), footer = true, bodyClass } = Astro.props;
const fullTitle = title ? `${title} · entrelinhas` : 'entrelinhas · livretos gratuitos sobre o feminino social';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(og, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#E6007E" />
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="entrelinhas" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
