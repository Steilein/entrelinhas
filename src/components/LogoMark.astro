---
/**
 * Monograma do entrelinhas: o "e" entre duas linhas, dentro da estrela.
 */
import { starburstPath } from '../lib/starburst';

interface Props {
  star?: string;
  ink?: string;
  seed?: number;
  class?: string;
  label?: string;
}

const { star = 'var(--lima)', ink = 'var(--preto)', seed = 7, class: className, label } = Astro.props;
const d = starburstPath({ seed, points: 14, inner: 0.5, jitter: 0.2 });
---

<svg
  class:list={['logomark', className]}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g class="logomark-star"><path d={d} fill={star}></path></g>
  <rect x="35" y="31" width="30" height="4" fill={ink}></rect>
  <text x="50" y="61" text-anchor="middle" fill={ink} class="logomark-e">e</text>
  <rect x="35" y="66" width="30" height="4" fill={ink}></rect>
</svg>

<style>
  .logomark-e {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 36px;
  }
  .logomark-star { transform-origin: 50% 50%; transform-box: fill-box; }
</style>
