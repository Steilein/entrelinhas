---
/**
 * Mapa ilustrado da home: as ruas viram "linhas" e os pontos reais aparecem como estrelas.
 * É só um desenho (leve, sem Leaflet); o mapa interativo fica em /mapa.
 */
import { mulberry32, starburstPath } from '../lib/starburst';
import type { Ponto } from '../lib/content';

interface Props {
  pontos: Ponto[];
}

const { pontos } = Astro.props;
const W = 600;
const H = 520;
const rand = mulberry32(42);

function family(angleDeg: number, seed: number) {
  const r = mulberry32(seed);
  const a = (angleDeg * Math.PI) / 180;
  const d = [Math.cos(a), Math.sin(a)];
  const n = [-Math.sin(a), Math.cos(a)];
  const lines: { x1: number; y1: number; x2: number; y2: number; w: number }[] = [];
  let t = -520;
  let i = 0;
  while (t < 520) {
    const cx = W / 2 + n[0] * t;
    const cy = H / 2 + n[1] * t;
    const wobble = (r() - 0.5) * 0.06;
    const dx = d[0] + wobble;
    const dy = d[1] - wobble;
    lines.push({ x1: cx - dx * 900, y1: cy - dy * 900, x2: cx + dx * 900, y2: cy + dy * 900, w: i % 5 === 2 ? 5 : 1.4 });
    t += 22 + r() * 30;
    i++;
  }
  return lines;
}

const streets = [...family(-24, 3), ...family(64, 9)];

// Enquadra o miolo da cidade (quantis 10%–90%); pontos mais distantes podem ficar fora do desenho.
const quantil = (values: number[], q: number) => {
  const s = [...values].sort((a, b) => a - b);
  return s[Math.round((s.length - 1) * q)];
};
const lats = pontos.map((p) => p.data.lat);
const lngs = pontos.map((p) => p.data.lng);
const [minLat, maxLat, minLng, maxLng] = [quantil(lats, 0.1), quantil(lats, 0.9), quantil(lngs, 0.1), quantil(lngs, 0.9)];
const pins = pontos.map((p, i) => {
  const x = 150 + ((p.data.lng - minLng) / (maxLng - minLng)) * (W - 240);
  const y = 190 + ((maxLat - p.data.lat) / (maxLat - minLat)) * (H - 300);
  const expositor = p.data.tipo === 'expositor';
  const s = expositor ? 40 : 22;
  return { x, y, s, expositor, d: starburstPath({ seed: i + 3, points: expositor ? 14 : 12, inner: 0.5, jitter: 0.22 }), delay: (rand() * 2.4).toFixed(2) };
});
---

<svg class="streets" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g class="streets-lines">
    {streets.map((s) => <line x1={s.x1.toFixed(1)} y1={s.y1.toFixed(1)} x2={s.x2.toFixed(1)} y2={s.y2.toFixed(1)} stroke-width={s.w}></line>)}
  </g>
  <g class="streets-pins">
    {pins.map((p) => (
      <g transform={`translate(${(p.x - p.s / 2).toFixed(1)} ${(p.y - p.s / 2).toFixed(1)})`}>
        <g class:list={['pin-g', { 'pin-g--exp': p.expositor }]} style={`animation-delay:${p.delay}s`}>
          <path d={p.d} transform={`scale(${p.s / 100})`}></path>
        </g>
      </g>
    ))}
  </g>
</svg>

<style>
  .streets { position: absolute; inset: 0; width: 100%; height: 100%; }
  .streets-lines line { stroke: var(--preto); opacity: 0.22; }
  .streets-lines line[stroke-width='5'] { opacity: 0.5; }
  .pin-g { fill: var(--preto); transform-box: fill-box; transform-origin: center; animation: pin-pulse 2.6s var(--ease-out) infinite; }
  .pin-g--exp { fill: var(--magenta); }
  @keyframes pin-pulse {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.18) rotate(12deg); }
  }
</style>
