---
/**
 * Cartaz lambe-lambe gerado com a identidade (placeholder até as fotos reais).
 * As 8 variantes reproduzem as composições do folder do entrelinhas.
 */
import Starburst from './Starburst.astro';
import Wordmark from './Wordmark.astro';
import LogoMark from './LogoMark.astro';
import { mulberry32 } from '../lib/starburst';

export type Variante = 'ideias' | 'forma' | 'questionar' | 'porque' | 'nenhum' | 'olhar' | 'explosao' | 'nada';

interface Props {
  variante: Variante;
  seed?: number;
  class?: string;
}

const { variante, seed = 1, class: className } = Astro.props;
const rand = mulberry32(seed * 97 + variante.length * 13);
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const pct = (min: number, max: number) => `${(min + rand() * (max - min)).toFixed(1)}%`;

const dots = range(7).map(() => ({ left: pct(4, 92), top: pct(6, 92), size: (3 + rand() * 4.5).toFixed(1) }));
const strokes = range(16).map(() => ({ left: pct(-6, 96), top: pct(-4, 98), rot: Math.round(-50 + rand() * 40), w: (9 + rand() * 7).toFixed(1) }));
const blobs = range(18).map(() => ({ left: pct(-6, 96), top: pct(-4, 98), rot: Math.round(rand() * 180), w: (6 + rand() * 9).toFixed(1) }));
const bursts = range(7).map((i) => ({ left: pct(-14, 82), top: pct(-12, 88), w: (18 + rand() * 30).toFixed(1), seed: seed * 10 + i }));
---

<div class:list={['poster', `poster--${variante}`, className]} aria-hidden="true">
  {variante === 'ideias' && (
    <div class="pz bg-lima grain">
      {dots.map((d) => <span class="dot dot--magenta" style={`left:${d.left};top:${d.top};--s:${d.size}cqi`}></span>)}
      <p class="big">Ideias ganham forma. Perspectivas ganham mundo.</p>
      <Wordmark class="mini-wm" />
    </div>
  )}

  {variante === 'forma' && (
    <div class="pz bg-ciano grain">
      <Starburst class="burst" seed={seed + 4} points={22} inner={0.22} jitter={0.5} fill="var(--branco)" />
      <Starburst class="burst burst--b" seed={seed + 9} points={18} inner={0.25} jitter={0.45} fill="var(--branco)" />
      {dots.slice(0, 5).map((d) => <span class="dot dot--lima" style={`left:${d.left};top:${d.top};--s:${d.size}cqi`}></span>)}
      <div class="stack-bottom">
        <p class="t-sans"><span class="box box--magenta">Conhecimento não precisa ficar preso a uma só forma.</span></p>
        <p class="t-serif"><span class="box box--branco">Pesquisa, cultura, educação, arte e comunicação se encontram para criar outras maneiras de acessar ideias.</span></p>
      </div>
      <Wordmark class="mini-wm" />
    </div>
  )}

  {variante === 'questionar' && (
    <div class="pz bg-magenta grain">
      {dots.map((d) => <span class="dot dot--lima" style={`left:${d.left};top:${d.top};--s:${d.size}cqi`}></span>)}
      <div class="stack-mid">
        <p class="t-sans t-xl"><span class="box box--ciano">Questionar o que parece inquestionável.</span></p>
        <p class="t-serif"><span class="box box--preto">O feminino social é nosso campo de investigação.</span></p>
      </div>
      <Wordmark class="mini-wm" />
    </div>
  )}

  {variante === 'porque' && (
    <div class="pz bg-lima grain">
      <div class="halftone halftone--ciano"></div>
      {dots.slice(0, 5).map((d) => <span class="dot dot--ciano" style={`left:${d.left};top:${d.top};--s:${d.size}cqi`}></span>)}
      <div class="stack-bottom">
        <p class="t-serif"><span class="box box--branco">Porque nem tudo está dito. Nem tudo está visível.</span></p>
        <p class="t-sans t-xl"><span class="box box--magenta">Por que entrelinhas?</span></p>
      </div>
      <Wordmark class="mini-wm mini-wm--top" />
    </div>
  )}

  {variante === 'nenhum' && (
    <div class="pz bg-branco">
      {strokes.map((s) => <span class="stroke" style={`left:${s.left};top:${s.top};--r:${s.rot}deg;--w:${s.w}cqi`}></span>)}
      <Wordmark class="mini-wm mini-wm--top" />
      <div class="stack-mid">
        <p class="t-serif t-xl"><span class="box box--lima">Nenhum conhecimento se constrói sozinho.</span></p>
      </div>
    </div>
  )}

  {variante === 'olhar' && (
    <div class="pz bg-branco">
      {blobs.map((b) => <span class="blob" style={`left:${b.left};top:${b.top};--r:${b.rot}deg;--w:${b.w}cqi`}></span>)}
      <Wordmark class="mini-wm mini-wm--top" />
      <div class="stack-mid">
        <p class="t-serif t-xl"><span class="box box--ciano">O que mais podemos descobrir quando mudamos o olhar?</span></p>
        <p class="t-sans"><span class="box box--magenta">O entrelinhas é uma construção em movimento.</span></p>
      </div>
    </div>
  )}

  {variante === 'explosao' && (
    <div class="pz bg-lima grain">
      {bursts.map((b) => (
        <Starburst class="burst-free" seed={b.seed} points={13} inner={0.36} jitter={0.3} fill="var(--magenta)" style={`left:${b.left};top:${b.top};width:${b.w}cqi`} />
      ))}
      <div class="wm-center"><Wordmark /></div>
      <div class="stack-bottom">
        <p class="t-sans"><span class="box box--ciano">Outras formas de pensar, criar e compartilhar conhecimento.</span></p>
      </div>
    </div>
  )}

  {variante === 'nada' && (
    <div class="pz bg-branco">
      <div class="halftone-blob"></div>
      <LogoMark class="nada-mark" star="var(--lima)" ink="var(--branco)" seed={seed + 2} />
      <p class="nada-word">entrelinhas</p>
      <div class="stack-bottom">
        <p class="t-sans"><span class="box box--lima">Ideias não surgem do nada.</span></p>
        <p class="t-sans"><span class="box box--lima">Conhecimento também não.</span></p>
      </div>
    </div>
  )}
</div>

<style>
  .poster {
    container-type: inline-size;
    aspect-ratio: 1 / 1.414;
    width: 100%;
    position: relative;
    overflow: hidden;
    background: var(--branco);
  }
  .pz {
    position: absolute;
    inset: 0;
    padding: 7cqi;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .big {
    position: relative;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 12.6cqi;
    line-height: 0.95;
    overflow-wrap: normal;
    letter-spacing: -0.045em;
    margin-top: auto;
    margin-bottom: auto;
  }
  .t-sans, .t-serif { position: relative; line-height: 1.32; }
  .t-sans { font-family: var(--font-display); font-weight: 700; font-size: 6.6cqi; letter-spacing: -0.02em; }
  .t-serif { font-family: var(--font-text); font-weight: 400; font-size: 5.4cqi; }
  .t-xl.t-sans { font-size: 10cqi; line-height: 1.12; }
  .t-xl.t-serif { font-size: 9cqi; line-height: 1.2; font-weight: 300; }
  .stack-bottom, .stack-mid { position: relative; display: grid; gap: 3cqi; }
  .stack-bottom { margin-top: auto; }
  .stack-mid { margin-block: auto; }

  .pz :global(.mini-wm) {
    position: absolute;
    right: 7cqi;
    bottom: 6cqi;
    font-size: 5cqi;
  }
  .pz :global(.mini-wm--top) { top: 6cqi; bottom: auto; left: 7cqi; right: auto; }
  .poster--forma .pz :global(.mini-wm), .poster--questionar .pz :global(.mini-wm) { top: 6cqi; bottom: auto; }
  .poster--questionar .pz { color: var(--preto); }

  .dot {
    position: absolute;
    width: var(--s);
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .dot--magenta { background: var(--magenta); }
  .dot--lima { background: var(--lima); }
  .dot--ciano { background: var(--ciano); }

  .pz :global(.burst) { position: absolute; width: 95cqi; left: -18cqi; top: -14cqi; opacity: 0.95; }
  .pz :global(.burst--b) { width: 60cqi; left: auto; right: -20cqi; top: 52cqi; }
  .pz :global(.burst-free) { position: absolute; }

  .halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--ciano) 28%, transparent 30%);
    background-size: 3.6cqi 3.6cqi;
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 70% 30%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 55% at 70% 30%, #000 20%, transparent 75%);
  }
  .stroke {
    position: absolute;
    width: var(--w);
    height: calc(var(--w) * 0.36);
    background: var(--magenta);
    border-radius: 60% 40% 55% 45% / 60% 50% 50% 40%;
    transform: rotate(var(--r));
  }
  .blob {
    position: absolute;
    width: var(--w);
    height: calc(var(--w) * 0.62);
    border: 2.2cqi solid var(--ciano);
    border-radius: 58% 42% 60% 40% / 50% 60% 40% 50%;
    transform: rotate(var(--r));
  }
  .wm-center {
    position: relative;
    margin-top: 16cqi;
    font-size: 17cqi;
    color: var(--preto);
  }
  .halftone-blob {
    position: absolute;
    inset: -10% -20% 10% -20%;
    background-image: radial-gradient(var(--magenta) 42%, transparent 46%);
    background-size: 2.6cqi 2.6cqi;
    -webkit-mask-image: radial-gradient(ellipse 50% 46% at 42% 46%, #000 30%, transparent 72%);
    mask-image: radial-gradient(ellipse 50% 46% at 42% 46%, #000 30%, transparent 72%);
    transform: rotate(-12deg);
  }
  .pz :global(.nada-mark) { position: absolute; width: 52cqi; right: -8cqi; top: -6cqi; }
  .nada-word {
    position: absolute;
    right: 6cqi;
    bottom: 34cqi;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 9cqi;
    letter-spacing: -0.03em;
    padding: 0.05em 0.3em;
    background: var(--magenta);
    color: var(--branco);
  }
</style>
