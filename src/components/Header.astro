---
import LogoMark from './LogoMark.astro';
import Starburst from './Starburst.astro';
import Wordmark from './Wordmark.astro';
import { url } from '../lib/url';
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/sobre', label: 'sobre' },
  { href: '/edicoes', label: 'edições' },
  { href: '/mapa', label: 'mapa' },
  { href: '/galeria', label: 'galeria' },
  { href: '/rodas', label: 'rodas' },
  { href: '/sua-vez', label: 'sua vez' },
];
const isActive = (href: string) => {
  const full = url(href);
  return path === full || path.startsWith(`${full}/`);
};
---

<header class="site-header">
  <div class="bar container">
    <a href={url('/')} class="brand" aria-label="entrelinhas, página inicial">
      <LogoMark class="brand-mark" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--lima cta" href={url('/mapa')}>
      <span class="cta-u">adquira</span> entrelinhas!
    </a>

    <button class="menu-btn" popovertarget="menu" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="menu" popover class="menu bg-magenta grain">
    <div class="menu-inner container">
      <div class="menu-top">
        <Wordmark size="2.1rem" />
        <button class="menu-close" popovertarget="menu" popovertargetaction="hide" aria-label="Fechar menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <nav aria-label="Menu">
        <ul role="list" class="menu-links">
          <li><a href={url('/')}>início</a></li>
          {links.map((l) => (
            <li><a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn--lima" href={url('/mapa')}>encontrar minha edição</a>
      <p class="menu-social">
        <a href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.usuario}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <Starburst class="menu-star" seed={11} points={15} fill="var(--lima)" spin />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    background: var(--magenta);
    color: var(--branco);
    view-transition-name: site-header;
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 40px);
  }
  .brand { display: block; flex: none; margin-right: auto; border-radius: 50%; }
  .brand :global(.brand-mark) {
    width: clamp(58px, 7vw, 74px);
    height: auto;
    margin-block: -6px;
    filter: drop-shadow(0 2px 0 rgb(0 0 0 / 0.12));
  }
  .brand:hover :global(.logomark-star) { animation: spin 6s linear infinite; }

  .nav ul { display: flex; gap: clamp(16px, 2.6vw, 36px); }
  .nav a {
    position: relative;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
    padding-block: 6px;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .nav a:hover::after, .nav a[aria-current='page']::after { transform: scaleX(1); }

  .cta { font-size: 1.05rem; }
  .cta-u { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .menu-btn {
    display: none;
    width: 48px; height: 48px;
    border-radius: var(--radius-sm);
    background: var(--preto);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .menu-btn span { display: block; width: 22px; height: 2.5px; background: var(--branco); border-radius: 2px; }

  @media (max-width: 860px) {
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
    .cta { min-height: 44px; padding: 0.55em 0.9em; font-size: 0.95rem; }
  }
  @media (max-width: 380px) {
    .cta-u { display: none; }
  }

  /* menu (popover nativo: fecha com ESC ou clique fora) */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden auto;
  }
  .menu:popover-open { display: block; animation: menu-in 0.35s var(--ease-out); }
  @keyframes menu-in { from { clip-path: circle(0% at 100% 0); } to { clip-path: circle(150% at 100% 0); } }
  .menu-inner { position: relative; min-height: 100%; padding-block: 18px 40px; display: flex; flex-direction: column; gap: 28px; }
  .menu-top { display: flex; align-items: center; justify-content: space-between; }
  .menu-close { width: 48px; height: 48px; display: grid; place-items: center; border-radius: var(--radius-sm); background: var(--preto); color: var(--branco); }
  .menu-close svg { width: 22px; }
  .menu-links { display: grid; gap: 4px; margin-top: 12px; }
  .menu-links a {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    font-size: clamp(2.6rem, 13vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .menu-links a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 4px; }
  .menu .btn { align-self: flex-start; }
  .menu-social { display: grid; gap: 6px; font-family: var(--font-display); font-weight: 600; }
  .menu-inner :global(.menu-star) {
    position: absolute;
    right: -70px; bottom: -60px;
    width: 260px;
    z-index: -1;
    opacity: 0.95;
  }
</style>
